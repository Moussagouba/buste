# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
RUST_LOG=info,melbet_analytics=debug

# PostgreSQL Database
DATABASE_URL=postgres://melbet_user:melbet_secure_pass@localhost:5432/melbet_analytics
DATABASE_MAX_CONNECTIONS=20

# 1. Melbet Collector Configuration
MELBET_API_BASE_URL=https://melbet.com/LineFeed
MELBET_COLLECTION_INTERVAL_SECS=60
MELBET_TARGET_SPORTS=1,2,3,4

# 2. API-Football (API-Sports) - 100 req/day free
# Obtenez votre clé gratuite sur https://www.api-football.com/
API_FOOTBALL_KEY=957bcdd00876b6d4f118d89eb7c15d11
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# 3. Football-Data.org - 10 req/min free
# Obtenez votre clé gratuite sur https://www.football-data.org/client/register
FOOTBALL_DATA_ORG_KEY=cf5a83b044344009b67871dfd6b06884
FOOTBALL_DATA_ORG_BASE_URL=https://api.football-data.org/v4

# 4. OpenLigaDB - Gratuit, aucune clé requise
OPENLIGADB_BASE_URL=https://api.openligadb.de

# 5. StatsBomb Open Data - Gratuit, fichiers GitHub raw
STATSBOMB_BASE_URL=https://raw.githubusercontent.com/statsbomb/open-data/master/data

# 6. Football-Data.co.uk - Gratuit, fichiers CSV historiques & anciennes cotes
FOOTBALL_DATA_UK_BASE_URL=https://www.football-data.co.uk/mmz4281

# 7. TheSportsDB - Gratuit (clé par défaut "3" pour les tests)
THESPORTSDB_KEY=3
THESPORTSDB_BASE_URL=https://www.thesportsdb.com/api/v1/json/3

# Risk & Bankroll Configuration
INITIAL_BANKROLL=1000.00
CURRENCY=EUR
KELLY_FRACTION=0.25
MAX_BET_PERCENTAGE=0.05
MIN_VALUE_EDGE=0.03
MAX_ODDS=4.50
MIN_ODDS=1.30

# Simulation & Settlement
PAPER_BETTING_AUTO_EXECUTE=true
SIMULATION_SETTLEMENT_INTERVAL_SECS=30
